{
  "name": "slopscan",
  "version": "0.1.0",
  "description": "Find complexity, duplication, dead code and other slop in JS/TS/Vue repos — per-file painscore + HTML dashboard.",
  "type": "module",
  "bin": {
    "slopscan": "bin/slopscan.mjs",
    "slopscan-analyze": "bin/analyze.mjs",
    "slopscan-diff": "bin/diff.mjs"
  },
  "files": [
    "bin",
    "lib",
    "presets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run tests/",
    "test:watch": "vitest tests/",
    "scan": "node bin/slopscan.mjs"
  },
  "keywords": [
    "static-analysis",
    "code-quality",
    "complexity",
    "duplication",
    "dead-code",
    "technical-debt",
    "typescript",
    "vue",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hugo0/slopscan.git"
  },
  "homepage": "https://github.com/Hugo0/slopscan#readme",
  "bugs": {
    "url": "https://github.com/Hugo0/slopscan/issues"
  },
  "author": "Hugo Montenegro",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jscpd": "^4.0.9",
    "knip": "^5.88.1",
    "ts-morph": "^28.0.0",
    "typhonjs-escomplex": "^0.1.0"
  },
  "devDependencies": {
    "vite": "~8.0.16",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "~8.0.16",
      "postcss": ">=8.5.18",
      "brace-expansion": ">=5.0.7"
    }
  }
}
